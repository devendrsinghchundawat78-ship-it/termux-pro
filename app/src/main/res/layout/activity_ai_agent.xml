<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF0B0F14">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FF11161D"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/ai_state_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FF7E8C99"
                android:textSize="12sp"
                android:maxLines="1"
                android:text="Idle" />

            <Button
                android:id="@+id/ai_stop_button"
                style="@style/Widget.TermuxApp.CompactButton.Inverse"
                android:background="@drawable/bg_button_danger"
                android:text="@string/ai_agent_stop"
                android:textColor="#FFF5F5F5"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/ai_clear_button"
                style="@style/Widget.TermuxApp.CompactButton.Inverse"
                android:text="@string/ai_agent_clear" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF26303B" />
    </LinearLayout>

    <!-- Log view -->
    <ScrollView
        android:id="@+id/ai_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/ai_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#FFDCDCDC"
            android:textIsSelectable="true"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <!-- Input row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FF11161D"
        android:elevation="4dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FF26303B" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp">

            <EditText
                android:id="@+id/ai_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="@string/ai_agent_input_hint"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:maxLines="3"
                android:textColor="#FFF0F0F0"
                android:textColorHint="#FF5A6A78"
                android:textSize="15sp"
                android:padding="10dp"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/ai_send_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:background="@drawable/bg_button_accent"
                android:text="@string/ai_agent_send"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:minHeight="0dp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
